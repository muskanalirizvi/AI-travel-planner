GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
# Set to 1 if HTTPS calls fail with CERTIFICATE_VERIFY_FAILED (common when
# AV/corporate software does TLS inspection). Trusts the OS cert store
# instead of certifi's bundled CA list.
USE_SYSTEM_CERTS=0

# MongoDB Atlas connection string, used by the save_preference/get_preference
# tools to remember user travel preferences across turns. If unset, those
# tools return a clear error instead of crashing the app.
MONGODB_URI=
# Optional: database name to use. If omitted, the database name embedded in
# MONGODB_URI is used, falling back to "travel_planner" if none is present.
MONGODB_DB=

# Tavily Search API key (free tier, 1000 searches/month) from tavily.com,
# used by the web_search tool for attractions, visa requirements, and other
# general travel info. If unset, the tool returns a clear error instead of
# crashing the app.
TAVILY_API_KEY=

# OpenRouteService API key (free tier, no billing card needed) from
# openrouteservice.org, used by the get_distance tool for driving
# distance/time between two locations. If unset, the tool returns a clear
# error instead of crashing the app.
ORS_API_KEY=

# Google Calendar setup for the create_event tool (adds itinerary events to
# your own calendar). Uses an installed-app OAuth2 flow, which is simplest
# for a single-user personal project (a service account would additionally
# require sharing your calendar with a robot email address, and can't act
# as "you" on your own primary calendar). Setup, one time only:
#   1. In Google Cloud Console (console.cloud.google.com), create a
#      project and enable the "Google Calendar API".
#   2. Under APIs & Services > Credentials, create an OAuth client ID of
#      type "Desktop app" and download the JSON file it gives you.
#   3. Point GOOGLE_CALENDAR_CREDENTIALS_FILE below at that downloaded
#      file.
#   4. Run `python scripts/authorize_google_calendar.py` once -- it opens
#      a browser for you to sign in and grant calendar access, then saves
#      a token file at GOOGLE_CALENDAR_TOKEN_FILE for the app to reuse
#      (and silently refresh) afterward.
# If these aren't set up, create_event returns these setup steps instead
# of crashing the app.
GOOGLE_CALENDAR_CREDENTIALS_FILE=google_calendar_credentials.json
GOOGLE_CALENDAR_TOKEN_FILE=google_calendar_token.json
# IANA timezone for created events, e.g. Asia/Karachi, Asia/Dubai. Defaults
# to UTC if unset.
GOOGLE_CALENDAR_TIMEZONE=UTC
